# Copy to .env before deploying:
#   cp .env.docker.example .env
#
# On your VPS, change every value below before going live.
#
# --- Option A: pull pre-built image from GHCR (recommended on VPS) ---
# GitHub Actions builds on push to main (.github/workflows/server-deploy.yml).
# 1. Set SERVER_IMAGE (replace YOUR_GITHUB_USER):
#      SERVER_IMAGE=ghcr.io/YOUR_GITHUB_USER/finance-tracker-server:latest
# 2. If the package is private: echo $GITHUB_PAT | docker login ghcr.io -u YOUR_GITHUB_USER --password-stdin
# 3. docker compose -f docker-compose.yml -f docker-compose.prod.yml pull server
# 4. docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --no-build
#
# --- Option B: build on the VPS (slow; needs more RAM) ---
#   docker compose up -d --build

# Host port mapped to container port 3001 (API listens on 3001 inside the container).
PORT=3001

# Pre-built API image from GHCR (required when using docker-compose.prod.yml)
# SERVER_IMAGE=ghcr.io/YOUR_GITHUB_USER/finance-tracker-server:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=finance_tracker

# Public API URL (must match your reverse proxy / domain)
BETTER_AUTH_URL=https://api.yourdomain.com

# Comma-separated frontend origins allowed by CORS
CLIENT_URL=https://yourdomain.com,https://your-app.vercel.app

# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-auth-secret

MOBILE_APP_SCHEME=financetracker

# Resend — password reset emails
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Finance Tracker <noreply@yourdomain.com>"

# Google Sheets — live asset prices
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/app/secrets/google-service-account.json
# GOOGLE_SHEET_RANGE=AssetPrices!A:D
# Do not point it at localhost when using compose; the API connects to host `db`.
# Postgres image: 17.4-alpine. If upgrading from an older major version, remove the
# postgres_data volume before starting (or dump/restore into a fresh volume).

# Optional: restore an existing Postgres backup on first container start.
# 1. Create a dump on your old machine:
#      pg_dump -Fc -h localhost -U postgres -d finance_tracker -f backups/database.dump
#    For plain SQL instead:
#      pg_dump -h localhost -U postgres -d finance_tracker -f backups/database.sql
# 2. Copy backups/database.dump to the VPS (into server/backups/).
# 3. Uncomment and set the path inside the container:
# PG_RESTORE_FILE=/app/backups/database.dump
# Set PG_RESTORE_FORCE=true only if you need to import the same dump again.
# PG_RESTORE_FORCE=false
