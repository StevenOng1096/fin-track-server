PORT=3000
# Comma-separated frontend origins (local + Vercel + custom domain)
CLIENT_URL=YOUR_CLIENT_URL
BETTER_AUTH_URL=YOUR_BETTER_AUTH_URL

DATABASE_URL=YOUR_DATABASE_URL

BETTER_AUTH_SECRET=change-me-better-auth-secret

# Expo mobile app URL scheme (must match mobile-client app.json)
MOBILE_APP_SCHEME=financetracker

NODE_ENV=development

# Resend — password reset and email verification emails
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Finance Tracker <noreply@yourdomain.com>

# Google Sheets — live asset prices (service account JSON must exist on disk)
GOOGLE_SHEET_ID=your-spreadsheet-id
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=portofolio-tracker-service-acc-key.json
# GOOGLE_SHEET_RANGE=AssetPrices!A:D
